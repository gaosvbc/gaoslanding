{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/reformas", "destination": "/reformas/index.html" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/contacto", "destination": "/contacto/index.html" },
    { "source": "/aviso-legal", "destination": "/aviso-legal/index.html" },
    { "source": "/politica-de-privacidad", "destination": "/politica-de-privacidad/index.html" },
    { "source": "/politica-de-cookies", "destination": "/politica-de-cookies/index.html" }
  ]
}
